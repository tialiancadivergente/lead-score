PORT=3000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
API_KEY_ENABLED=false
INTERNAL_API_KEY=change-me
CAPTURE_SYNC_API_KEY=change-me-capture-sync-key

# Auth / RBAC
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PAGE_TEMPLATE_IMAGE_BLOB_CONTAINER=page-template-images
PAGE_TEMPLATE_IMAGE_MAX_BYTES=8388608
PAGE_TEMPLATE_IMAGE_SERVE_PREFIX=/page/template-images
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
AUTH_TRUSTED_PROXY_CIDRS=

# PostgreSQL local para migrations/desenvolvimento
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lead_score
DB_SSL=false
DB_UUID_EXTENSION=pgcrypto
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Desabilitar integrações externas localmente
SERVICE_BUS_ENABLED=false
SERVICE_BUS_CONSUMER_ENABLED=false
SERVICE_BUS_LEAD_REGISTRATION_CONSUMER_ENABLED=false
