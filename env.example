PORT=3000
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
API_KEY_ENABLED=false
INTERNAL_API_KEY=change-me

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=lead_score
DB_SSL=false
DB_UUID_EXTENSION=pgcrypto
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=20000
DB_STATEMENT_TIMEOUT_MS=20000
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# Azure Service Bus
SERVICE_BUS_ENABLED=false
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=<keyname>;SharedAccessKey=<key>
SERVICE_BUS_LEAD_SCORE_QUEUE=lead-score
SERVICE_BUS_LEAD_SCORE_CAPTURE_RETRY_MAX=12
SERVICE_BUS_LEAD_SCORE_CAPTURE_RETRY_DELAY_SECONDS=30
SERVICE_BUS_CONSUMER_ENABLED=false
SERVICE_BUS_MAX_RETRIES=5
SERVICE_BUS_RETRY_DELAY_MS=200
SERVICE_BUS_MAX_RETRY_DELAY_MS=5000

# Fila: cadastro de leads
SERVICE_BUS_LEAD_REGISTRATION_QUEUE=lead-registration
SERVICE_BUS_LEAD_REGISTRATION_CONSUMER_ENABLED=false
SERVICE_BUS_LEAD_REGISTRATION_MAX_CONCURRENCY=3
SERVICE_BUS_LEAD_SCORE_CONSUMER_ENABLED=false
SERVICE_BUS_LEAD_SCORE_MAX_CONCURRENCY=2

# ActiveCampaign
ACTIVECAMPAIGN_BASE_URL=https://<sua-conta>.api-us1.com
ACTIVECAMPAIGN_API_TOKEN=<seu-token>
ACTIVECAMPAIGN_CREATE_CONTACT_PATH=/api/3/contacts

# HubSpot (consulta de contatos, sem persistencia)
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_REQUEST_TIMEOUT_MS=10000

# Databricks SQL (consulta de pedidos no data lake)
DATABRICKS_HOST=adb-7607122378232015.15.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/0a7731024fd249e0
DATABRICKS_TOKEN=
DATABRICKS_TIMEOUT_MS=120000
